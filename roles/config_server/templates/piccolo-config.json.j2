{%- macro addr_url(a) -%}
{{ '[' + a + ']' if ':' in a else a }}
{%- endmacro -%}
{%- set ns = namespace(rows=[]) -%}
{% for host in groups['piccolo_perf'] %}
{%   set pa = hostvars[host]['probe_address'] | default(hostvars[host]['mesh_ipv6'] | default('')) %}
{%   if pa %}
{%     set ns.rows = ns.rows + [{'name': (hostvars[host]['piccolo_name'] | default(host)), 'addr': pa, 'site': (hostvars[host]['site'] | default('unknown') | string)}] %}
{%   endif %}
{% endfor %}
{
  "topology": "mesh",
  "config_refresh": "5m",
  "hide_skipped": false,
  "hosts": [
{% for row in ns.rows %}
    { "name": {{ row.name | to_json }}, "address": {{ row.addr | to_json }}, "site": {{ row.site | to_json }} }{{ "" if loop.last else "," }}
{% endfor %}
  ],
  "hub_spoke": { "enabled": false, "hub": "" },
  "measurements": {{ piccolo_perf_measurements | to_nice_json(indent=2) | indent(2) }},
  "influxdb": { "url": "", "token": "", "org": "", "bucket": "" },
  "local_store": { "enabled": false, "path": "/var/lib/piccolo-perf/results.jsonl", "max_lines": 10000 }
}
