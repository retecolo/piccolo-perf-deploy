{
  "topology": "mesh",
  "config_refresh": "5m",
  "hide_skipped": false,
  "hosts": [
{% for host in groups['piccolo_perf'] %}
    { "name": {{ host | to_json }}, "address": {{ hostvars[host]['mesh_ipv6'] | to_json }}, "site": {{ hostvars[host]['site'] | default('unknown') | string | to_json }} }{{ "" if loop.last else "," }}
{% endfor %}
  ],
  "hub_spoke": { "enabled": false, "hub": "" },
  "measurements": {{ piccolo_perf_measurements | to_nice_json(indent=2) | indent(2) }},
  "influxdb": { "url": "", "token": "", "org": "", "bucket": "" },
  "local_store": { "enabled": false, "path": "/var/lib/piccolo-perf/results.jsonl", "max_lines": 10000 }
}
