global:
  scrape_interval: 60s
  scrape_timeout: 10s

scrape_configs:
  - job_name: piccolo_perf
    scheme: https
    static_configs:
      - targets:
{% for host in groups['piccolo_perf'] | default([]) %}
          - "{{ host }}.{{ mesh_domain }}:{{ hostvars[host].piccolo_perf_metrics_port | default(9862) }}"
{% endfor %}
