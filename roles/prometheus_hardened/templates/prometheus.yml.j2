global:
  scrape_interval: 60s
  scrape_timeout: 10s

scrape_configs:
  - job_name: piccolo_perf
    scheme: https
    tls_config:
      insecure_skip_verify: true
    static_configs:
      - targets:
{% for host in groups['piccolo_perf'] %}
{% if hostvars[host]['mesh_ipv6'] is defined %}
          - "[{{ hostvars[host]['mesh_ipv6'] }}]:{{ piccolo_perf_metrics_port | default(9862) }}"
{% endif %}
{% endfor %}
