global:
  scrape_interval: 60s
  scrape_timeout: 10s

scrape_configs:
  - job_name: piccolo_perf
    scheme: https
    tls_config:
      insecure_skip_verify: true
    static_configs:
      - targets:
{% for host in piccolo_perf_hosts %}
          - "[{{ host.address }}]:{{ piccolo_perf_metrics_port | default(9862) }}"
{% endfor %}
