{%- macro addr_url(a) -%}
{{ '[' + a + ']' if ':' in a else a }}
{%- endmacro -%}

global:
  scrape_interval: 60s
  scrape_timeout: 10s

scrape_configs:
  - job_name: piccolo_perf
    scheme: https
    tls_config:
      insecure_skip_verify: true
    static_configs:
      - targets:
{% for host in groups['piccolo_perf'] %}
{%   set pa = hostvars[host]['probe_address'] | default(hostvars[host]['mesh_ipv6'] | default('')) %}
{%   if pa %}
          - "{{ addr_url(pa) }}:{{ piccolo_perf_metrics_port | default(9862) }}"
{%   endif %}
{% endfor %}
